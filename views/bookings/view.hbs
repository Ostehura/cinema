<div class="container my-5">
<h1>Booking: {{booking.id}}</h1>
  
  {{#if bookings.length}}
  <div class="row">
    {{#each bookings}}
    <div class="col-md-4 mb-4">
      <div class="card booking-card h-100 shadow-sm border-0">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title">{{this.user.firstName}} {{this.user.lastName}}</h5>
          <h6 class="card-subtitle mb-2 text-muted">Booking #{{this.id}}</h6>
          
          <div class="mb-3">
            <p class="mb-1"><strong>Showtime:</strong> {{this.showtime.starttime}}</p>
            <p class="mb-1"><strong>Movie:</strong> {{this.showtime.filmFormat.film.title}}</p>
            <p class="mb-1"><strong>Format:</strong> {{this.showtime.filmFormat.seansFormat}}</p>
          </div>
          
          <div class="mb-2">
            <p class="mb-1"><strong>Tickets:</strong> {{this.amount}} Full, {{this.amountReduced}} Reduced</p>
            <p class="mb-1"><strong>Total:</strong> {{add this.amount this.amountReduced}} tickets</p>
          </div>
          
          {{#if this.guestEmail}}
          <div class="mb-2">
            <p class="mb-1"><strong>Guest Email:</strong> {{this.guestEmail}}</p>
          </div>
          {{/if}}
          
          <div class="mt-auto">
            {{#if (and (or (eq ../userRole 'ADMIN') (eq ../userRole 'CUSTOMER')) (eq ../userId this.userID))}}
            <form action="/booking/{{this.id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');">
              <button type="submit" class="btn btn-danger btn-sm w-100">Delete Booking</button>
            </form>
            {{/if}}
          </div> 
        </div>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  {{/if}}
  
</div>
          <div class="card-body">
            <div class="row mb-4">
              <div class="col-md-6">
                <h5>Customer Information</h5>
                {{#if booking.user}}
                <p><strong>Name:</strong> {{booking.user.firstName}} {{booking.user.lastName}}</p>
                <p><strong>Email:</strong> {{booking.user.email}}</p>
                {{/if}}
                {{#if booking.guestEmail}}
                <p><strong>Guest Email:</strong> {{booking.guestEmail}}</p>
                {{/if}}
              </div>
              <div class="col-md-6">
                <h5>Booking Information</h5>
                <p><strong>Booking ID:</strong> {{booking.id}}</p>
                <p><strong>Booking Time:</strong> {{booking.datetime}}</p>
                <p><strong>Status:</strong> 
                  <span class="badge bg-success">Confirmed</span>
                </p>
              </div>
            </div>

            <div class="mb-4">
              <h5>Showtime Details</h5>
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Movie:</strong> {{booking.showtime.filmFormat.film.title}}</p>
                  <p><strong>Format:</strong> {{booking.showtime.filmFormat.seansFormat}}</p>
                  <p><strong>Start Time:</strong> {{booking.showtime.starttime}}</p>
                  <p><strong>End Time:</strong> {{booking.showtime.endtime}}</p>
                </div>
                <div class="col-md-6">
                  <p><strong>Auditorium:</strong> {{booking.showtime.audithorium.name}}</p>
                  <p><strong>Showtime ID:</strong> {{booking.showtime.id}}</p>
                </div>
              </div>
            </div>

            <h5>Tickets ({{booking.tickets.amount}})</h5>
            <div class="mb-4">
              {{#if booking.tickets.length}}
              {{#each booking.tickets}}
              <div class="ticket-card">
                <div class="row">
                  <div class="col-md-6">
                    <p><strong>Ticket Type:</strong> 
                      <span class="badge bg-{{#if (eq this.ticketType 'FULL')}}success{{else}}warning{{/if}}">
                        {{this.ticketType}}
                      </span>
                    </p>
                    <p><strong>Seat:</strong> 
                      <span class="seat-badge badge bg-info">
                        Row {{this.seatRow}}, Seat {{this.seatNumber}}
                      </span>
                    </p>
                  </div>
                  <div class="col-md-6">
                    <a href ="/ticket/{{this.id}}"><strong>See ticket</strong></a>
                  </div>
                </div>
              </div>
              {{/each}}
              {{else}}
              <p class="text-muted">No tickets found for this booking.</p>
              {{/if}}
            </div>

            <div class="mt-4">
               {{#if (or 
                 (eq userRole 'ADMIN')
                 (and 
                   (eq userRole 'CUSTOMER')
                   (eq userId booking.userID)
                 )
               )}}
               <a href="/booking/edit/{{booking.id}}" class="btn btn-warning me-2">Edit Booking</a>
               <form action="/booking/{{booking.id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');" class="d-inline">
                 <button type="submit" class="btn btn-danger">Delete Booking</button>
               </form>
               {{/if}}

               <a href="/booking/my-bookings" class="btn btn-secondary">Back to Bookings</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</div>