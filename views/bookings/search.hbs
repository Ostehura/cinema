<!DOCTYPE html>
<html>
<head>
  <title>Cinema - Search Bookings</title>

  <style>
    body { padding-top: 70px; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">Cinema</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/film">Films</a>
        <a class="nav-link" href="/filmformat">Formats</a>
        <a class="nav-link" href="/booking">Bookings</a>
        <a class="nav-link active" href="/booking/search">Search</a>
        <a class="nav-link" href="/ticket">Tickets</a>
        <a class="nav-link" href="/showtime">Showtimes</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card mt-5">
          <div class="card-header bg-info text-white">
            <h3 class="mb-0">Search Reservations</h3>
          </div>
          <div class="card-body">
            <form action="/booking" method="GET">
              <div class="mb-3">
                <label class="form-label">User ID</label>
                <input type="text" class="form-control" name="userID" placeholder="Enter user ID">
              </div>
              <div class="mb-3">
                <label class="form-label">Guest Email</label>
                <input type="email" class="form-control" name="guestEmail" placeholder="Enter guest email">
              </div>
              <div class="mb-3">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" name="date">
              </div>
              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-info">Search Bookings</button>
                <a href="/booking" class="btn btn-outline-secondary">View All Bookings</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>