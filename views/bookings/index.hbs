<h1>Bookings</h1>
<p><a href="/booking" class="btn-primary"></a></p>


  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">Cinema</a>
      <div class="navbar-nav">
        <a class="nav-link" href="/film">Films</a>
        <a class="nav-link active" href="/booking">Bookings</a>
        <a class="nav-link" href="/showtime">Showtimes</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Search Reservations</h3>
          </div>
          <div class="card-body">
            <form action="/booking/search" method="GET" class="row g-3">
              <div class="col-md-4">
                <label class="form-label">User ID</label>
                <input type="text" class="form-control" name="userID" placeholder="Enter user ID">
              </div>
              <div class="col-md-4">
                <label class="form-label">Guest Email</label>
                <input type="email" class="form-control" name="guestEmail" placeholder="Enter guest email">
              </div>
              <div class="col-md-4">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" name="date">
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary w-100">Search</button>
                <a href="/booking" class="btn btn-outline-secondary w-100 mt-2">View All Bookings</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    {{#if bookings.length}}
    <div class="row">
      <div class="col-12">
        <h2>Bookings Found ({{bookings.length}})</h2>
        <div class="row">
          {{#each bookings}}
          <div class="col-md-4 mb-4">
            <div class="card booking-card h-100 shadow-sm border-0">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{this.user?.firstName}} {{this.user?.lastName}}</h5>
                <h6 class="card-subtitle mb-2 text-muted">Booking #{{this.id}}</h6>
                
                <div class="mb-3">
                  <p class="mb-1"><strong>Showtime:</strong> {{this.showtime.starttime}}</p>
                  <p class="mb-1"><strong>Movie:</strong> {{this.showtime.filmFormat?.film?.title}}</p>
                  <p class="mb-1"><strong>Format:</strong> {{this.showtime.filmFormat?.seansFormat}}</p>
                </div>
                
                <div class="mb-2">
                  <p class="mb-1"><strong>Tickets:</strong> {{this.amount}} Full, {{this.amountReduced}} Reduced</p>
                  <p class="mb-1"><strong>Total:</strong> {{add this.amount this.amountReduced}} tickets</p>
                </div>
                
                {{#if this.guestEmail}}
                <div class="mb-2">
                  <p class="mb-1"><strong>Guest Email:</strong> {{this.guestEmail}}</p>
                </div>
                {{/if}}
                
                <div class="mt-auto">
                  {{#if (and (or (eq ../userRole 'ADMIN') (eq ../userRole 'CUSTOMER')) (eq ../userId this.userID))}}
                  <form action="/booking/{{this.id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');">
                    <button type="submit" class="btn btn-danger btn-sm w-100">Delete Booking</button>
                  </form>
                  {{/if}} --}}
                </div>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    {{else}}
    <div class="row">
      <div class="col-12 text-center py-5">
        <h3>No bookings found matching your criteria</h3>
        <p class="text-muted">Try adjusting your search filters</p>
        <a href="/booking/search" class="btn btn-outline-primary">New Search</a>
      </div>
    </div>
    {{/if}}

    <script>
      // Helper function for template comparison
      function eq(a, b) {
        return a === b;
      }

      function or(a, b) {
        return a || b;
      };

      function and(a, b) {
        return a && b;
      };
    </script>
  </div>
