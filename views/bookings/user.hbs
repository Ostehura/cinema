
<div class="container my-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card mb-4">
          <div class="card-header bg-success text-white">
            <h3 class="mb-0">Bookings for User ID: {{userId}}</h3>
          </div>
          <div class="card-body">
            {{#if bookings.length}}
            <div class="table-responsive">
              <table class="table table-hover">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Showtime</th>
                    <th>Movie</th>
                    <th>Format</th>
                    <th>Tickets</th>
                    <th>Email</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each bookings}}
                  <tr>
                    <td>{{@index}}</td>
                    <td>{{this.showtime.starttime}}</td>
                    <td>{{this.showtime.filmFormat?.film?.title}}</td>
                    <td>{{this.showtime.filmFormat?.seansFormat}}</td>
                    <td>{{this.amount}} Full, {{this.amountReduced}} Reduced</td>
                    <td>{{#if this.guestEmail}}{{this.guestEmail}}{{else}}{{this.user?.email}}{{/if}}</td>
                    <td>
                      {{#if (or (eq ../userRole 'ADMIN') (and (eq ../userRole 'CUSTOMER') (eq ../userId this.userID)))}}
                      <form action="/booking/{{this.id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                      </form>
                      {{/if}}
                    </td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
            {{else}}
            <div class="alert alert-info">No bookings found for this user.</div>
            {{/if}}
            <a href="/booking/user/{{userId}}" class="btn btn-outline-secondary">Refresh</a>
            <a href="/booking" class="btn btn-outline-primary">Back to All Bookings</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Helper function for template comparison
    function eq(a, b) {
      return a === b;
    }
  </script>
</div>