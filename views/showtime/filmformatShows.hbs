<div class="container mt-4">
    <a  class="btn btn-info fw-bold px-4" href="/showtime" style="margin: 10px;"> To all films</a>

   <div class="d-flex flex-wrap gap-2 mb-2">

{{#each days}}

        <a
            href="/showtime/ff/{{../filmFormatId}}?date={{url}}"
           class="btn btn-warning fw-bold px-4  {{#if disabled}} disabled {{/if}}"
        >
            {{ date }}
            {{!-- {{startime}} --}}
        </a>

{{/each}}
    </div>

{{#each films}}
    <div class="row border-bottom py-4">

        <!-- Poster -->
        <div class="col-md-2">
            <img
                src="https://placehold.co/180x260?text={{this.filmFormat.film.title}}"
                class="img-fluid rounded shadow-sm"
                alt="{{this.filmFormat.film.title}}"
            >
        </div>

        <!-- Movie info -->
        <div class="col-md-10">
            <a href="/film/view/{{this.filmFormat.film.id}}"> 
            <h3 class="fw-bold text-uppercase mb-2">
                {{this.filmFormat.film.title}}
            </h3>
            </a>

            <div class="text-muted mb-3">
                Director: {{this.filmFormat.film.director}}
                |
                {{this.filmFormat.film.duration}} min
            </div>

            <!-- FORMATS -->
          
                <div class="mb-4 p-3 bg-light rounded">

                    <!-- Format title -->
                    <h5 class="fw-bold text-uppercase mb-3">
                        {{filmFormat.seansFormat}}
                    </h5>

                    <!-- Showtimes -->
                  

                    <a
                        href="/showtime/show/{{id}}"
                        class="btn btn-warning fw-bold px-4 {{#if (futureDate starttime)}}{{else}}disabled{{/if}}"
                    >
                        {{formatHour starttime}}
                        {{!-- {{startime}} --}}
                    </a>


                    <!-- Language -->
                    <div class="text-secondary small">
                        {{filmFormat.dubbing}}
                    </div>

                </div>

    

        </div>

    </div>
{{/each}}
{{!-- <input type="hidden" id="date" value={{}} --}}
</div>

<script>
    const formatInput = document.getElementById('format');
    const languageInput = document.getElementById('language');
    const date = "{{selectedDay}}";
    const language = "{{selectedLanguage}}";
    const format = "{{selectedFormat}}";
    formatInput.addEventListener('change', (e) => {
    if (e.target.value === 'Select format') {   
        window.location.replace('/showtime?date=' + date + '&language=' + language);
    } else {
        window.location.replace(
            '/showtime?date=' + date +
            '&language=' + language +
            '&format=' + e.target.value
        );
    }
    });
    languageInput.addEventListener('change', (e) => {
    if (e.target.value === 'Select language') {
        window.location.replace('/showtime?date=' + date + '&format=' + format);
    } else {
        window.location.replace(
            '/showtime?date=' + date +
            '&language=' + e.target.value +
            '&format=' + format
        );
    }
    });
</script>