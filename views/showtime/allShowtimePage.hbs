
<div class="container mt-5">

    <div class="container mt-4">
    <div class="d-flex flex-wrap gap-2 mb-2">

    {{#each days}}

        <a
            href="/showtime?date={{url}}"
            class="btn btn-warning fw-bold px-4"
        >
            {{ title }}
            {{!-- {{startime}} --}}
        </a>

    {{/each}}
    </div>

        {{#each films}}
            <div class="row border-bottom py-4">

                <!-- Poster -->
                <div class="col-md-2">
                    <img
                        src="https://placehold.co/180x260?text={{title}}"
                        class="img-fluid rounded shadow-sm"
                        alt="{{title}}"
                    >
                </div>

                <!-- Movie info -->
                <div class="col-md-10">

                    <h3 class="fw-bold text-uppercase mb-2">
                        {{title}}
                    </h3>

                    <div class="text-muted mb-3">
                        Director: {{director}}
                        |
                        {{duration}} min
                    </div>

                    <!-- FORMATS -->
                    {{#each filmFormat}}

                        <div class="mb-4 p-3 bg-light rounded">

                            <!-- Format title -->
                            <h5 class="fw-bold text-uppercase mb-3">
                                {{seansFormat}}
                            </h5>

                            <!-- Showtimes -->
                            <div class="d-flex flex-wrap gap-2 mb-2">

                                {{#each showtimes}}

                                    <a
                                        href="/showtime/show/{{id}}"
                                        class="btn btn-warning fw-bold px-4"
                                    >
                                        {{formatHour starttime}}
                                        {{!-- {{startime}} --}}
                                    </a>

                                {{/each}}

                            </div>

                            <!-- Language -->
                            <div class="text-secondary small">
                                {{dubbing}}
                            </div>

                        </div>

                    {{/each}}

                </div>

            </div>
        {{/each}}

    </div>
</div>