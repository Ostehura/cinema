
    {{#if future.length}}
    <h2>Future</h2>
    {{#each future}}
        <div class="row border-bottom py-4">



            <!-- Movie info -->
            <div class="col-md-10">

                <h4 class="fw-bold text-uppercase mb-2">
                    {{this.showtime.filmFormat.film.title}}
                </h4>

                <b class="fw-bold text-uppercase mb-2">
                    {{this.showtime.starttime}}
                </b>

                <div>
                    Full tickets: {{this.amount}}
                    Reduced: {{this.amountReduced}}
                    Glasses: {{this.glasses}}
                </div>

                <a href="/booking/{{this.id}}" class="btn btn-primary-100">Full info</a>


            </div>

        </div>
    {{/each}}
    {{else}}
    <h3>No current bookings 😕. <a href="/showtime">Let`s find a new film for you!</a></h2>
    {{/if}}
    <br/>
    {{#if past.length}}
    <h2>Past</h2>
    {{#each past}}
        <div class="row border-bottom py-4">



            <!-- Movie info -->
            <div class="col-md-10">

                <h4 class="fw-bold text-uppercase mb-2">
                    {{this.showtime.filmFormat.film.title}}
                </h4>

                <b class="fw-bold text-uppercase mb-2">
                    {{this.showtime.starttime}}
                </b>

                <div>
                    Full tickets: {{this.amount}}
                    Reduced: {{this.amountReduced}}
                    Glasses: {{this.glasses}}
                </div>

                <a href="/booking/{{this.id}}" class="btn btn-primary-100">Full info</a>


            </div>

        </div>
    {{/each}}
    {{/if}}

</div>