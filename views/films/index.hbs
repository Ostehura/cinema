<!-- Admin Film Management -->
<div class="container">
    <div class="section-title">
        <h2>Manage Films</h2>
        <a href="/film/new" class="btn btn-primary">Add New Film</a>
    </div>
    
    {{#if films.length}}
    <div class="films-grid">
        {{#each films}}
        <div class="film-card">
            <div class="film-poster" style="background-image: url('https://via.placeholder.com/400x600/000000/FFFFFF?text={{title}}')">
                <button class="play-button">▶</button>
            </div>
            <div class="film-info">
                <h3>{{title}}</h3>
                <div class="meta">
                    <span>{{duration}} min</span>
                    <span>{{director}}</span>
                </div>
                <p>{{description}}</p>
                <div class="film-actions">
                    <a href="/film/view/{{this.id}}" class="btn btn-outline">View Details</a>
                    <a href="/film/edit/{{this.id}}" class="btn btn-outline">Edit</a>
                    <form action="/film/delete/{{this.id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this film?');" style="display: inline;">
                        <button type="submit" class="btn btn-outline" style="background-color: #f44336; color: white; border: none;">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="alert alert-info">No films available.</div>
    {{/if}}
</div>