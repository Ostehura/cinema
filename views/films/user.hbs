<div class="container">
    <div class="section-title">
        <h2>Films</h2>
    </div>

    
    {{#if films.length}}
    <div class="films-grid">
        {{#each films}}
        <div class="film-card">
            <div class="film-poster" style="background-image: url('https://via.placeholder.com/400x600/000000/FFFFFF?text={{title}}')">
                <button class="play-button">▶</button>
            </div>
            <div class="film-info">
                <h3>{{title}}</h3>
                <div class="meta">
                    <span>{{duration}} min</span>
                    <span>{{director}}</span>
                </div>
                <p>{{description}}</p>
                <div class="film-actions">
                    <a href="/film/view/{{this.id}}" class="btn btn-outline">View Details</a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="alert alert-info">No films available.</div>
    {{/if}}
</div>