<!DOCTYPE html>
<html>
<head>
  <title>{{ 'Cinema'}}</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { padding-top: 70px; }
    .navbar-dark { background-color: #2c3e50; }
    .btn-primary { background-color: #e74c3c; border-color: #e74c3c; }
    .btn-primary:hover { background-color: #c0392b; border-color: #c0392b; }
    .footer { background-color: #ecf0f1; padding: 20px 0; margin-top: 40px; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="/">Cinema</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage '/')}}active{{/if}}" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage '/film')}}active{{/if}}" href="/film">Films</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage '/filmformat')}}active{{/if}}" href="/filmformat">Formats</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage '/booking')}}active{{/if}}" href="/booking">Bookings</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage '/ticket')}}active{{/if}}" href="/ticket">Tickets</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{#if (eq activePage  '/showtime')}}active{{/if}}" href="/showtime">Showtimes</a>
          </li>
          {{#if user}}
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              {{user.firstName}} {{user.lastName}}
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/booking/user/{{user.userId}}">My Tickets</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/auth/logout">Logout</a></li>
            </ul>
          </li>
          {{else}}
          <li class="nav-item">
            <a class="nav-link" href="/auth/login">Login</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/auth/register">Register</a>
          </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <div class="container">
    {{{body}}}
  </div>

  <div class="footer text-center">
    <div class="container">
      <p>&copy; {{year}} Cinema. All rights reserved.</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>