<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <style>
    .chat-box {
      height: 400px;
      overflow-y: auto;
      border: 1px solid #ccc;
      padding: 15px;
      margin-bottom: 15px;
      background-color: #f9f9f9;
    }
    .message {
      margin-bottom: 10px;
    }
    .message .sender {
      font-weight: bold;
    }
    .message .timestamp {
      font-size: 0.8rem;
      color: #888;
    }
  </style>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <span>Movie</span> Town
            </div>
            <div class="nav-links">
                <a href="/" class="nav-link {{#if (eq activePage '/')}}active{{/if}}">Home</a>
                <a href="/film" class="nav-link {{#if (eq activePage '/film')}}active{{/if}}">Films</a>
                <a href="/showtime" class="nav-link {{#if (eq activePage '/showtime')}}active{{/if}}">Showtimes</a>
                <a href="/booking/my-bookings" class="nav-link {{#if (eq activePage '/booking/my-bookings')}}active{{/if}}">My Bookings</a>
                <a href="/auth/logout" class="nav-link {{#if (eq activePage '/auth/logout')}}active{{/if}}">Logout</a>           
                <a href="/cart" class="nav-link {{#if (eq activePage '/cart')}}active{{/if}}">Cart</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        {{{body}}}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>About Movie Town</h3>
                    <p>Experience movies like never before with state-of-the-art technology and luxurious comfort.</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="/">Now Showing</a></li>
                        <li><a href="/auth/login">Login</a></li>
                        <li><a href="/auth/register">Register</a></li>
                        <li><a href="/cart">Concessions</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Contact Us</h3>
                    <ul>
                        <li>info@movietown.com</li>
                        <li>555-123-444</li>
                        <li>123 Movie Lane, Movie</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© {{year}} Movie Town. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>