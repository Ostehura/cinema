<div class="container my-5">
   <div class="row justify-content-center">
     <div class="col-md-8">
       <div class="card">
         <div class="card-header bg-dark text-white">
           <h3 class="mb-0">Booking Details</h3>
         </div>
         <div class="card-body">
           <div class="row mb-4">
             <div class="col-md-6">
               <h5>Customer Information</h5>
               <p><strong>Name:</strong> {{booking.user.firstName}} {{booking.user.lastName}}</p>
               <p><strong>Email:</strong> {{booking.user.email}}</p>
               {{#if booking.guestEmail}}
               <p><strong>Guest Email:</strong> {{booking.guestEmail}}</p>
               {{/if}}
             </div>
             <div class="col-md-6">
               <h5>Booking Information</h5>
               <p><strong>Booking ID:</strong> {{booking.id}}</p>
               <p><strong>Booking Time:</strong> {{booking.datetime}}</p>
               <p><strong>Status:</strong> 
                 <span class="badge bg-success">Confirmed</span>
               </p>
             </div>
           </div>
 
           <div class="mb-4">
             <h5>Showtime Details</h5>
             <div class="row">
               <div class="col-md-6">
                 <p><strong>Movie:</strong> {{booking.showtime.filmFormat.film.title}}</p>
                 <p><strong>Format:</strong> {{booking.showtime.filmFormat.seansFormat}}</p>
                 <p><strong>Start Time:</strong> {{formatDate booking.showtime.starttime}} at {{formatHour booking.showtime.starttime}}</p>
                 <p><strong>End Time:</strong> {{formatDate booking.showtime.endtime}} at {{formatHour booking.showtime.starttime}}</p>
               </div>
               <div class="col-md-6">
                 <p><strong>Auditorium:</strong> {{booking.showtime.audithorium.name}}</p>
                 <p><strong>Showtime ID:</strong> {{booking.showtime.id}}</p>
               </div>
             </div>
           </div>
 
           <h5>Tickets ({{booking.tickets.length}})</h5>
           <div class="mb-4">
             {{#if booking.tickets.length}}
               <div class="table-responsive">
                 <table class="table table-hover">
                   <thead class="table-light">
                     <tr>
                       <th>#</th>
                       <th>Seat</th>
                       <th>Type</th>
                     </tr>
                   </thead>
                   <tbody>
                     {{#each booking.tickets}}
                     <tr>
                       <td>{{@index}}</td>
                       <td>Row {{this.seatRow}}, Seat {{this.seatNumber}}</td>
                       <td>
                         <span class="badge bg-{{#if (eq this.ticketType 'full')}}success{{else}}warning{{/if}}">
                           {{this.ticketType}}
                         </span>
                       </td>
                       <td><a href="/ticket/{{this.id}}" class="btn btn-warning">See Ticket Details</a></td>
                     </tr>
                     {{/each}}
                   </tbody>
                 </table>
               </div>
             {{else}}
               <p class="text-muted">No tickets found for this booking.</p>
             {{/if}}
           </div>
            <h5>Actions </h5>
            <div class="mt-4">


              <form action="/booking/{{id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');" class="d-inline">
                <button type="submit" class="btn btn-danger btn-sm">Delete Booking</button>
              </form>


              <a href="/booking" class="btn btn-secondary">
                Back to Search Bookings
              </a>



            </div>
          </div>
        </div>
      </div>
    </div>
 
</div>