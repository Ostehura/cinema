

<div class="container my-5">
<h1>Bookings</h1>
<p><a href="/booking" class="btn-primary"></a></p>



  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Search Reservations</h3>
          </div>
          <div class="card-body">
            <form action="/booking" method="GET" class="row g-3">
              <div class="col-md-4">
                <label class="form-label">User ID</label>
                <input type="text" class="form-control" name="userID" placeholder="Enter user ID">
              </div>
              <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="guestEmail" placeholder="Enter guest email">
              </div>
              <div class="col-md-4">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" name="datetime">
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary w-100">Search</button>
                <a href="/booking" class="btn btn-outline-secondary w-100 mt-2">View All Bookings</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    {{#if bookings.length}}
      <div class="row">
        <div class="col-12">
          <h2>Bookings Found ({{bookings.length}})</h2>
          <div class="row">
            {{#each bookings}}
            <div class="col-md-4 mb-4">
              <div class="card booking-card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                  <h5 class="card-title">{{user.firstName}} {{user.lastName}}</h5>
                  <h6 class="card-subtitle mb-2 text-muted">Booking #{{id}}</h6>

                  <div class="mb-3">
                    <p><strong>Showtime:</strong> {{formatDate showtime.starttime}} at {{formatHour showtime.starttime}}</p>
                    <p><strong>Movie:</strong> {{showtime.filmFormat.film.title}}</p>
                    <p><strong>Format:</strong> {{showtime.filmFormat.seansFormat}}</p>
                  </div>

                  <a href="/booking/{{this.id}}" class="btn btn-primary mb-2">
                    View Details
                  </a>

                  



                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

    {{else}}

    <div class="row">
      <div class="col-12 text-center py-5">
        <h3>No bookings found matching your criteria</h3>
        <p class="text-muted">Try adjusting your search filters</p>
        <a href="/booking/search" class="btn btn-outline-primary">New Search</a>
      </div>
    </div>
    {{/if}}

  </div>
</div>


