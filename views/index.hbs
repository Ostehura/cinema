<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1>Experience the Magic of Cinema</h1>
        <p>Now showing the latest blockbusters and timeless classics</p>
        <div class="hero-buttons">
            <a href="/film" class="btn-primary">See What's Playing</a>
            <a href="/auth/login" class="btn-secondary">Login to Book</a>
        </div>
    </div>
</section>

<!-- Films Section -->
<section class="main-content">
    <div class="container">
        <div class="section-title">
            <h2>Now Playing</h2>
        </div>
        <div class="films-grid">
            {{#if films.length}}
                 {{#each films}}
        <div class="row border-bottom py-4">

            <!-- Poster -->
            <div class="col-md-2">
                <img
                    src="https://placehold.co/180x260?text={{title}}"
                    class="img-fluid rounded shadow-sm"
                    alt="{{title}}"
                >
            </div>

            <!-- Movie info -->
            <div class="col-md-10">

                <h3 class="fw-bold text-uppercase mb-2">
                    {{title}}
                </h3>

                <div class="text-muted mb-3">
                    Director: {{director}}
                    |
                    {{duration}} min
                </div>

                <!-- FORMATS -->
                {{#each filmFormat}}

                    <div class="mb-4 p-3 bg-light rounded">

                        <!-- Format title -->
                        <h5 class="fw-bold text-uppercase mb-3">
                            {{seansFormat}}
                        </h5>

                        <!-- Showtimes -->

                        <!-- Language -->
                        <div class="text-secondary small">
                            {{dubbing}}
                        </div>
                         <a class="text-secondary small" href="/showtime/ff/{{id}}">
                          Look for seans
                         </a>


                    </div>

                {{/each}}

            </div>

        </div>
    {{/each}}
            {{else}}
                <div class="col-12">
                    <p class="text-center">No films available at the moment.</p>
                </div>
            {{/if}}
        </div>
    </div>
</section>